  <ExternalCommands>
    <Trigger action="init">
      <IfCommand ifCondition="eqs(@isPreviewMode,'true')">
        <Consequent>
          <FrameRateCommand rate="120"/>
        </Consequent>
        <Alternate>
          <FrameRateCommand rate="0"/>
        </Alternate>
      </IfCommand>
    </Trigger>
    <Trigger action="init">
      <IfCommand ifCondition="eqs(@isPreviewMode,'true')">
        <Consequent>
          <VideoCommand target="aiVideo" command="config" path="'assets/ai/ai.mp4'" loop="1" scaleMode="2"/>
        </Consequent>
        <Alternate>
          <VideoCommand target="aiVideo" command="config" path="'assets/ai/ai.mp4'" loop="0" scaleMode="2"/>
        </Alternate>
      </IfCommand>
    </Trigger>
    <Trigger action="resume">
      <MultiCommand condition="((! #aod_state_tk1lPAJ2) ** #is_paused_tk1lPAJ2)">
        <FunctionCommand target="replayVideo"/>
      </MultiCommand>
      <MultiCommand condition="(! #is_paused_tk1lPAJ2)">
        <FunctionCommand target="playVideo"/>
      </MultiCommand>
      <MultiCommand condition="(#isDisplayDefaultBg_tk1lPAJ2 == 1)">
        <FunctionCommand target="releaseVideo"/>
      </MultiCommand>
    </Trigger>
    <Trigger action="pause">
      <FunctionCommand target="pauseVideo"/>
      <VariableCommand name="is_paused_tk1lPAJ2" expression="1" type="number"/>
