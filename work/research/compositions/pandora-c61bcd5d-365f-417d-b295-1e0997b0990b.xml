    <Trigger action="enterAod">
      <VariableCommand name="aod_state_tk1lPAJ2" expression="1" type="number"/>
    </Trigger>
    <Trigger action="exitAod">
      <VariableCommand name="aod_state_tk1lPAJ2" expression="0" type="number"/>
      <MultiCommand condition="((#is_finished_tk1lPAJ2 == 1) || (#is_paused_tk1lPAJ2 == 1))">
        <FunctionCommand target="replayVideo"/>
      </MultiCommand>
    </Trigger>
    <Trigger action="enterEdit">
      <VariableCommand name="is_edit_tk1lPAJ2" expression="1" type="number"/>
