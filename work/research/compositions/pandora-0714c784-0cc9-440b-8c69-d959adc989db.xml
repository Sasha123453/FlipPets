    </Trigger>
    <Trigger action="exitEdit">
      <VariableCommand name="is_edit_QXPsWn4o" expression="0" type="number"/>
      <MultiCommand condition="(#is_finished_QXPsWn4o == 1)">
        <FunctionCommand target="replayVideo"/>
      </MultiCommand>
    </Trigger>
    <Trigger action="enterAod">
      <FunctionCommand target="switchStateAod"/>
      <VariableCommand name="aod_state_3tz8OeiX" expression="1" type="number"/>
