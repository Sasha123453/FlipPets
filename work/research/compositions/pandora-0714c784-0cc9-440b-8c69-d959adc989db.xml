    <Trigger action="resume">
      <MultiCommand condition="((! #aod_state_QXPsWn4o) ** #is_paused_QXPsWn4o)">
        <FunctionCommand target="replayVideo"/>
      </MultiCommand>
      <MultiCommand condition="(! #is_paused_QXPsWn4o)">
        <FunctionCommand target="playVideo"/>
      </MultiCommand>
      <MultiCommand condition="(#isDisplayDefaultBg_QXPsWn4o == 1)">
        <FunctionCommand target="releaseVideo"/>
      </MultiCommand>
