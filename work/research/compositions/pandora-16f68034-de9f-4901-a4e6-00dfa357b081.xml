      <MultiCommand condition="(#is_finished_MpYi3eRb == 1)">
        <FunctionCommand target="replayVideo"/>
      </MultiCommand>
    </Trigger>
    <Trigger action="enterAod">
      <FunctionCommand target="switchStateAod"/>
      <VariableCommand name="aod_state_Ej39L7RI" expression="1" type="number"/>
      <ExternCommand command="__clearTalkback"/>
    </Trigger>
    <Trigger action="exitAod">
      <FunctionCommand target="switchStateDesk"/>
      <VariableCommand name="aod_state_Ej39L7RI" expression="0" type="number"/>
      <ExternCommand command="__clearTalkback"/>
    </Trigger>
  </ExternalCommands>
</Widget>
