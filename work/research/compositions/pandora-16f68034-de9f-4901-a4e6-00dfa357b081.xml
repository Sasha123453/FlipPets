    <Trigger action="enterAod">
      <VariableCommand name="aod_state_MpYi3eRb" expression="1" type="number"/>
    </Trigger>
    <Trigger action="exitAod">
      <VariableCommand name="aod_state_MpYi3eRb" expression="0" type="number"/>
      <MultiCommand condition="((#is_finished_MpYi3eRb == 1) || (#is_paused_MpYi3eRb == 1))">
        <FunctionCommand target="replayVideo"/>
