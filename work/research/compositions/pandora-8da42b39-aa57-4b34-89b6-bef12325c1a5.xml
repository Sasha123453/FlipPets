          <Text visibility="(#showTime_WcJK4uGJ == 1)" x="#layerLeftBuffer_WcJK4uGJ" y="(#timeAreaHeight_WcJK4uGJ / 2)" w="#safeAreaWidth_WcJK4uGJ" size="#timeSize_WcJK4uGJ" spacingMultExp="#lineHeight_WcJK4uGJ" fontPath="@fontPath_WcJK4uGJ" color="@textColor_WcJK4uGJ" textExp="formatDate(@timeFormat_WcJK4uGJ,#time_sys)" textAlign="@textAlign_WcJK4uGJ" name="time_text" alignV="center" enableClip="false"/>
