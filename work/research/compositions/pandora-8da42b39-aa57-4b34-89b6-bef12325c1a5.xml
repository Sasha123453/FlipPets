    <Var name="p2Height_WcJK4uGJ" type="number" expression="596"/>
    <Var name="p2AvailableWidth_WcJK4uGJ" type="number" expression="696"/>
    <Var name="p2MarginLeftRatio_WcJK4uGJ" type="number" expression="((#p2Width_WcJK4uGJ - #p2AvailableWidth_WcJK4uGJ) / #p2Width_WcJK4uGJ)"/>
