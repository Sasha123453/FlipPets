    </Trigger>
    <Trigger action="exitEdit">
      <VariableCommand name="is_edit_E9Q5UDiO" expression="0" type="number"/>
      <MultiCommand condition="(#is_finished_E9Q5UDiO == 1)">
        <FunctionCommand target="replayVideo"/>
      </MultiCommand>
    </Trigger>
    <Trigger action="enterAod">
      <FunctionCommand target="switchStateAod"/>
      <VariableCommand name="aod_state_WcJK4uGJ" expression="1" type="number"/>
