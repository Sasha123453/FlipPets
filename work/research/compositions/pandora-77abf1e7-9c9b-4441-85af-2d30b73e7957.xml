  <ExternalCommands>
    <Trigger action="init">
      <IfCommand ifCondition="eqs(@isPreviewMode,'true')">
        <Consequent>
          <FrameRateCommand rate="120"/>
        </Consequent>
        <Alternate>
          <FrameRateCommand rate="0"/>
        </Alternate>
      </IfCommand>
    </Trigger>
    <Trigger action="init">
      <IfCommand ifCondition="eqs(@isPreviewMode,'true')">
        <Consequent>
          <VideoCommand target="aiVideo" command="config" path="'assets/ai/ai.mp4'" loop="1" scaleMode="2"/>
        </Consequent>
        <Alternate>
          <VideoCommand target="aiVideo" command="config" path="'assets/ai/ai.mp4'" loop="0" scaleMode="2"/>
        </Alternate>
      </IfCommand>
    </Trigger>
    <Trigger action="resume">
      <MultiCommand condition="((! #aod_state_xASIXwyu) ** #is_paused_xASIXwyu)">
        <FunctionCommand target="replayVideo"/>
      </MultiCommand>
      <MultiCommand condition="(! #is_paused_xASIXwyu)">
        <FunctionCommand target="playVideo"/>
      </MultiCommand>
      <MultiCommand condition="(#isDisplayDefaultBg_xASIXwyu == 1)">
        <FunctionCommand target="releaseVideo"/>
      </MultiCommand>
    </Trigger>
    <Trigger action="pause">
      <FunctionCommand target="pauseVideo"/>
      <VariableCommand name="is_paused_xASIXwyu" expression="1" type="number"/>
    </Trigger>
    <Trigger action="enterAod">
      <VariableCommand name="aod_state_xASIXwyu" expression="1" type="number"/>
    </Trigger>
    <Trigger action="exitAod">
      <VariableCommand name="aod_state_xASIXwyu" expression="0" type="number"/>
      <MultiCommand condition="((#is_finished_xASIXwyu == 1) || (#is_paused_xASIXwyu == 1))">
        <FunctionCommand target="replayVideo"/>
      </MultiCommand>
    </Trigger>
    <Trigger action="enterEdit">
      <VariableCommand name="is_edit_xASIXwyu" expression="1" type="number"/>
      <MultiCommand condition="eq(#selected,0)">
        <VariableCommand name="is_finished_xASIXwyu" expression="1" type="number"/>
        <FunctionCommand target="setVideoFirstFrame"/>
        <FunctionCommand target="pauseVideo"/>
      </MultiCommand>
    </Trigger>
    <Trigger action="exitEdit">
      <VariableCommand name="is_edit_xASIXwyu" expression="0" type="number"/>
      <MultiCommand condition="(#is_finished_xASIXwyu == 1)">
        <FunctionCommand target="replayVideo"/>
      </MultiCommand>
    </Trigger>
    <Trigger action="enterAod">
      <FunctionCommand target="switchStateAod"/>
      <VariableCommand name="aod_state_BZIx2bcR" expression="1" type="number"/>
      <ExternCommand command="__clearTalkback"/>
    </Trigger>
    <Trigger action="exitAod">
      <FunctionCommand target="switchStateDesk"/>
      <VariableCommand name="aod_state_BZIx2bcR" expression="0" type="number"/>
      <ExternCommand command="__clearTalkback"/>
    </Trigger>
