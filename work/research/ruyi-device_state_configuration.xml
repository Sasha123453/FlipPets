<!-- vendor config for GSI -->
<device-state-config>
  <device-state>
    <identifier>0</identifier>
    <name>CLOSED</name>
    <conditions>
      <sensor>
        <type>xiaomi.sensor.flip_status</type>
        <name>flip_status  Wakeup</name>
        <value>
          <min>0</min>
        </value>
      </sensor>
    </conditions>
  </device-state>
  <device-state>
    <identifier>3</identifier>
    <name>OPENED</name>
    <conditions>
      <sensor>
        <type>xiaomi.sensor.flip_status</type>
        <name>flip_status  Wakeup</name>
        <value>
          <max>1</max>
        </value>
      </sensor>
    </conditions>
  </device-state>
</device-state-config>
