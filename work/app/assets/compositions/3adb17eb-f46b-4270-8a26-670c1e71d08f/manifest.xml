    </Trigger>
    <Trigger action="exitAod">
      <VariableCommand name="isAOD" expression="0" type="number"/>
      <VariableCommand name="aodDone" expression="0" type="number"/>
      <FrameRateCommand rate="120"/>
      <FunctionCommand target="querySteps"/>
      <FolmeCommand target="main_content" config="'folme_config_2'" states="'folme_state_2'" command="to"/>
      <FolmeCommand target="aod_bg" config="'folme_config_3'" states="'folme_state_3'" command="to"/>
    </Trigger>
    <Trigger action="resume">
      <VariableCommand name="_resume" expression="(#_resume + 1)" type="number"/>
      <IfCommand ifCondition="#isAOD">
        <Consequent>
          <MultiCommand condition="(! #aodDone)">
            <FunctionCommand target="querySteps"/>
          </MultiCommand>
        </Consequent>
        <Alternate>
          <FunctionCommand target="setAniRate"/>
          <FunctionCommand target="querySteps"/>
        </Alternate>
      </IfCommand>
    </Trigger>
    <Trigger action="pause"/>
    <Trigger action="appUninstalled">
      <FunctionCommand target="querySteps"/>
    </Trigger>
  </ExternalCommands>
