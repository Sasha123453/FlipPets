      <Variable name="steps_goal" column="goal" type="number"/>
      <Trigger>
        <VariableCommand name="queryDone" expression="1" type="number"/>
      </Trigger>
    </ContentProviderBinder>
    <ContentProviderBinder name="MiSteps2" uriExp="'content://com.mi.health.provider.main/activity/steps/timeline'" order="time ASC" columns="steps,time">
      <Variable name="halfHourStepsStr" column="steps" type="string[]"/>
      <Variable name="halfHourTimesStr" column="time" type="string[]"/>
      <Trigger>
        <VariableCommand name="i" type="number" expression="0"/>
        <LoopCommand loopCondition="(#i { 48)" count="999">
          <VariableCommand name="halfHourSteps" expression="0" type="number[]" index="#i"/>
          <VariableCommand name="i" expression="#i + 1" type="number"/>
        </LoopCommand>
        <VariableCommand name="i" type="number" expression="0"/>
        <LoopCommand loopCondition="(#i { 48)" count="999">
          <MultiCommand condition="(preciseeval(@halfHourStepsStr[#i],0) } 0)">
            <VariableCommand name="halfHourSteps" expression="preciseeval(@halfHourStepsStr[#i],0)" type="number[]" index="int((((preciseeval(@halfHourTimesStr[#i],0) - #time0) + 5) / (30 * 60)))"/>
          </MultiCommand>
          <VariableCommand name="i" expression="#i + 1" type="number"/>
        </LoopCommand>
        <FunctionCommand target="updateStepBars"/>
      </Trigger>
    </ContentProviderBinder>
  </VariableBinders>
  <ExternalCommands>
    <Trigger action="enterAod">
      <FrameRateCommand rate="120"/>
      <VariableCommand name="isAOD" expression="1" type="number"/>
      <VariableCommand name="aodDone" expression="0" type="number"/>
      <FolmeCommand target="main_content" config="'folme_config_0'" states="'folme_state_0'" command="to"/>
